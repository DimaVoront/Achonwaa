  m_EditorClassIdentifier: Assembly-CSharp::SubtitleAudioSystem
  audioSource: {fileID: 181614717}
  subtitleText: {fileID: 121217653}
  dialogueGroups:
  - groupName: Lapu2
    dialogueLines:
    - audioClip: {fileID: 8300000, guid: e3996d59caf3c064faf2fbc9c4eb8f42, type: 3}
      subtitle: "Despu\xE9s de una ardua lucha, \r\nla comunidad logr\xF3 expulsar
        a los colonizadores.\r\n"
      pauseAfter: 0
    - audioClip: {fileID: 8300000, guid: cf9c58bb7bb07fb438851b834df89b10, type: 3}
      subtitle: 'Pero la victoria tuvo un precio.



'
      pauseAfter: 0
    - audioClip: {fileID: 8300000, guid: a7d858e78faba67439f91ef52d9f3df3, type: 3}
      subtitle: "Wuinka regres\xF3 a casa herido pero con la satisfacci\xF3n de haber
        defendido su territorio.\r\n"
      pauseAfter: 0
