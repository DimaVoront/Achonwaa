  subtitleText: {fileID: 897694682}
  dialogueGroups:
  - groupName: Interaction1
    dialogueLines:
    - audioClip: {fileID: 8300000, guid: abc165a947e756d428cca9f95118330f, type: 3}
      subtitle: "\xA1Qu\xE9 bello que es vivir para la comunidad!\r\n\r\n"
      pauseAfter: 0
    - audioClip: {fileID: 8300000, guid: 916e13649d7fd634c9e27d21cbd06c5a, type: 3}
      subtitle: "desde hace generaciones, las mujeres de nuestro pueblo recorren
        los campos para recolectar frutos y ayudar a alimentar a todos. \r\n"
      pauseAfter: 0
    - audioClip: {fileID: 8300000, guid: 78b59f8e6a5d7394486b8868a687759d, type: 3}
      subtitle: "\xA1Acompa\xF1a a Kashi y ay\xFAdala a llenar su canasta!"
      pauseAfter: 12
    - audioClip: {fileID: 8300000, guid: 0988fe06bffe34445afada3eb0d6f948, type: 3}
      subtitle: '

'
      pauseAfter: 5
    - audioClip: {fileID: 8300000, guid: 306894efa7f7b314fa4a025ef3dc27ec, type: 3}
      subtitle: '

'
      pauseAfter: 13
    - audioClip: {fileID: 8300000, guid: e988c78087cd7364b8978edd653c594a, type: 3}
      subtitle: '

'
      pauseAfter: 26
    - audioClip: {fileID: 8300000, guid: 36839e1ecd532744bb460610a3045a7d, type: 3}
      subtitle: '

'
      pauseAfter: 15
    - audioClip: {fileID: 8300000, guid: 97373bde77e830441a65917748609544, type: 3}
