--- !u!114 &1923629168
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 1923629167}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 6f8e1468c07dbe144a769fe473021b89, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::SubtitleAudioSystem
  audioSource: {fileID: 1978619412}
  subtitleText: {fileID: 897694682}
  dialogueGroups:
  - groupName: Dialogue2
    dialogueLines:
    - audioClip: {fileID: 8300000, guid: bee7b90d0251fa640a6c9d0ba7d6c10b, type: 3}
      subtitle: "Ahora es momento de recolectar agua para la comunidad. \r\n"
      pauseAfter: 0
    - audioClip: {fileID: 8300000, guid: 31b22e0d209b01842a6913980ed4b706, type: 3}
      subtitle: "El r\xEDo est\xE1 cerca."
      pauseAfter: 0
    - audioClip: {fileID: 8300000, guid: fa5172e12bc65d54fa84e32a589b8287, type: 3}
      subtitle: "\xA1Camina hacia \xE9l!"
      pauseAfter: 5
    - audioClip: {fileID: 8300000, guid: a26e3c08af680024d864fab6285359eb, type: 3}
      subtitle: "\xA1Cuidado!"
      pauseAfter: 0
    - audioClip: {fileID: 8300000, guid: 7bf1b3936850d0c49958d3af16ab23f9, type: 3}
      subtitle: 'Casi olvido decirte algo muy importante.  '
      pauseAfter: 0
    - audioClip: {fileID: 8300000, guid: 837991ca139418a469ddb07b6c5818a0, type: 3}
      subtitle: "Debes caminar con cuidado porque \xA1Kashi est\xE1 embarazada! "
      pauseAfter: 0
    - audioClip: {fileID: 8300000, guid: 7344c1ca3370cc64586c84e64f8149d9, type: 3}
      subtitle: "Sus movimientos ser\xE1n m\xE1s lentos "
      pauseAfter: 0
    - audioClip: {fileID: 8300000, guid: caa5569257e55fc428eaee31edc8ae7d, type: 3}
      subtitle: "y deber\xE1 esforzarse m\xE1s para completar algunas tareas."
      pauseAfter: 0
    - audioClip: {fileID: 8300000, guid: 92acb20bd620b6446afbaa5ae46a55d1, type: 3}
      subtitle: " \xA1Llega al r\xEDo con cuidado!"
      pauseAfter: 5
    - audioClip: {fileID: 8300000, guid: 306894efa7f7b314fa4a025ef3dc27ec, type: 3}
      subtitle: 
      pauseAfter: 5
    - audioClip: {fileID: 8300000, guid: d3ea27ebbe80a8e438c8278824b0d9bb, type: 3}
      subtitle: 
      pauseAfter: 4
    - audioClip: {fileID: 8300000, guid: 90b46d031259a0745929413c901a3568, type: 3}
      subtitle: 
      pauseAfter: 10
    - audioClip: {fileID: 8300000, guid: 57d932ca886c0f347933115e68570359, type: 3}
      subtitle: 
      pauseAfter: 5
