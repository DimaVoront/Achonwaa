--- !u!114 &1571068755
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 1571068754}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 6f8e1468c07dbe144a769fe473021b89, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::SubtitleAudioSystem
  audioSource: {fileID: 1571068756}
  subtitleText: {fileID: 897694682}
  dialogueGroups:
  - groupName: Interaction1
    dialogueLines:
    - audioClip: {fileID: 8300000, guid: 2fccaf3fa71542b4f9a65d151dfcb86d, type: 3}
      subtitle: "\xA1Qu\xE9 hermoso es crecer!\r\n"
      pauseAfter: 0
    - audioClip: {fileID: 8300000, guid: 019b94c884b6a2e4e8d2470cc5fbb54c, type: 3}
      subtitle: "Cuenta la leyenda que el espiritu Wale\u2019ker\xFC,"
      pauseAfter: 0
    - audioClip: {fileID: 8300000, guid: 1f1a44127f517214e84710a061f2a097, type: 3}
      subtitle: "una hermosa ara\xF1a, ense\xF1\xF3 a las mujeres Wayuu el arte de
        tejer. "
      pauseAfter: 0
    - audioClip: {fileID: 8300000, guid: e665c9d9944e4714582e39d5b534eb4e, type: 3}
      subtitle: No son simples adornos,
      pauseAfter: 0
    - audioClip: {fileID: 8300000, guid: 372ca1373cdbc8b468ed79a96eb36c64, type: 3}
      subtitle: representan elementos de la naturaleza,
      pauseAfter: 0
    - audioClip: {fileID: 8300000, guid: 601e067a71ee3b94783fb07cfba9a86a, type: 3}
      subtitle: animales,
      pauseAfter: 0
    - audioClip: {fileID: 8300000, guid: 4074062d9f836ec4fb36ae1d34287289, type: 3}
      subtitle: astros y emociones que reflejan la vida cotidiana
      pauseAfter: 0
    - audioClip: {fileID: 8300000, guid: 9f46ecfbfcddae643bd1cb02c002b73f, type: 3}
      subtitle: "y el pensamiento Wayuu a trav\xE9s de sus kanaas."
      pauseAfter: 2
    - audioClip: {fileID: 8300000, guid: 046620810cc18ab4c9488df9ad7b916d, type: 3}
      subtitle: "Hija m\xEDa, tejer es un acto sagrado dentro\r\nde la comunidad."
      pauseAfter: 0
    - audioClip: {fileID: 8300000, guid: a87a23bf3651d9744862b2cf380eaa94, type: 3}
      subtitle: "Llevas el don en tus manos y por eso es importante que hagas el
        ritual de encierro \r\ntras tu primera menstruaci\xF3n,"
      pauseAfter: 0
    - audioClip: {fileID: 8300000, guid: a24b938e375277b4690fb2552502be39, type: 3}
      subtitle: "donde te ense\xF1ar\xE9 la t\xE9cnica y los valores que protegemos."
      pauseAfter: 20
    - audioClip: {fileID: 8300000, guid: cd0d2cc3c43101241bff9bcc1e2860f0, type: 3}
      subtitle: 
      pauseAfter: 12
    - audioClip: {fileID: 8300000, guid: 06db980fecf86314a984c2bc217e46de, type: 3}
      subtitle: 
      pauseAfter: 9
    - audioClip: {fileID: 8300000, guid: 345ab380d1c00544d8b38d6ca31b2cd1, type: 3}
      subtitle: 
      pauseAfter: 11
    - audioClip: {fileID: 8300000, guid: 5d7903ba316ba164ebb5203074902958, type: 3}
      subtitle: 
      pauseAfter: 7
    - audioClip: {fileID: 8300000, guid: ebfe2e3f86e1519479b38427435df4e1, type: 3}
      subtitle: 
      pauseAfter: 14
    - audioClip: {fileID: 8300000, guid: c96cc88ddc22100449495b9e7b0b376e, type: 3}
      subtitle: 
      pauseAfter: 14
    - audioClip: {fileID: 8300000, guid: bf7c537626ac0d541b6eaa43ca7461fa, type: 3}
      subtitle: 
      pauseAfter: 14
