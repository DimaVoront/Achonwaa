--- !u!114 &161709230
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 161709228}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 6f8e1468c07dbe144a769fe473021b89, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::SubtitleAudioSystem
  audioSource: {fileID: 161709229}
  subtitleText: {fileID: 334406232}
  dialogueGroups:
  - groupName: Lapu1
    dialogueLines:
    - audioClip: {fileID: 8300000, guid: 83faa49c4b78deb4a913f3cf6a9dc198, type: 3}
      subtitle: "\xA1Qu\xE9 hermoso es crecer!"
      pauseAfter: 0
    - audioClip: {fileID: 8300000, guid: 532942de683362a469613f8027a7402b, type: 3}
      subtitle: "Es tradici\xF3n que los hombres asuman la tarea de caza como parte
        de sus deberes cotidianos. "
      pauseAfter: 0
    - audioClip: {fileID: 8300000, guid: 3bd27e6206b79b64bb07da08ff5c0f0d, type: 3}
      subtitle: "\xA1A explorar!"
      pauseAfter: 1
    - audioClip: {fileID: 8300000, guid: 9dd61549cde3e6f4dae6ec8850a55dfa, type: 3}
      subtitle: 'Debes ser cauteloso para no asustarlo. '
      pauseAfter: 0
    - audioClip: {fileID: 8300000, guid: 9e17e4ca5eb0c9b418c17ffe1b72383c, type: 3}
      subtitle: "Utiliza este arco, tal y como te ense\xF1\xE9."
      pauseAfter: 12
    - audioClip: {fileID: 8300000, guid: 47748461cb216d74b83cf0c9b62100d3, type: 3}
      subtitle: 
      pauseAfter: 12
    - audioClip: {fileID: 8300000, guid: db19d21d619a62240b8778ad5cd7001b, type: 3}
      subtitle: 
      pauseAfter: 15
    - audioClip: {fileID: 8300000, guid: 71bc270a689869946b5e1b2192e01f24, type: 3}
      subtitle: 
      pauseAfter: 10
    - audioClip: {fileID: 8300000, guid: fe7a5c3c84bfc624d9ef31407554b7bb, type: 3}
      subtitle: 
      pauseAfter: 20
  - groupName: Lapu1
    dialogueLines:
    - audioClip: {fileID: 8300000, guid: 6f3ce707201bd114db2a6f551fa9c12c, type: 3}
      subtitle: "\xA1Qu\xE9 hermoso es crecer! Es tradici\xF3n que los hombres asuman
        la tarea de caza como parte de sus deberes cotidianos. \xA1A explorar!"
      pauseAfter: 1
    - audioClip: {fileID: 8300000, guid: b86a2abf9960a2a459b08235549422e4, type: 3}
      subtitle: "Debes ser cauteloso para no asustarlo. Utiliza este arco, tal como
        te ense\xF1\xE9."
      pauseAfter: 12
    - audioClip: {fileID: 8300000, guid: ac04f45b608db424395ff9170a76ff87, type: 3}
      subtitle: 
      pauseAfter: 60
